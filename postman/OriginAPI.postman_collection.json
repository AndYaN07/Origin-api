{
	"info": {
		"name": "OriginAPI",
		"description": "Endpoints de Origin API. Ajusta la variable baseUrl si la API no corre en http://localhost:8080.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "taskId", "value": "1" }
	],
	"item": [
		{
			"name": "Crear tarea",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Devuelve 201', () => pm.response.to.have.status(201));",
							"pm.collectionVariables.set('taskId', pm.response.json().id);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Preparar entrevista técnica\",\n  \"description\": \"Repasar Spring Boot, JPA y SQL\",\n  \"priority\": \"ALTA\",\n  \"dueDate\": \"2026-12-15\"\n}"
				},
				"url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
			}
		},
		{
			"name": "Listar tareas (paginado)",
			"request": {
				"method": "GET",
				"url": {
					"raw": "{{baseUrl}}/tasks?page=0&size=10&sort=createdAt,desc",
					"host": ["{{baseUrl}}"],
					"path": ["tasks"],
					"query": [
						{ "key": "page", "value": "0" },
						{ "key": "size", "value": "10" },
						{ "key": "sort", "value": "createdAt,desc" }
					]
				}
			}
		},
		{
			"name": "Listar tareas pendientes de prioridad ALTA",
			"request": {
				"method": "GET",
				"url": {
					"raw": "{{baseUrl}}/tasks?completed=false&priority=ALTA&sort=dueDate,asc",
					"host": ["{{baseUrl}}"],
					"path": ["tasks"],
					"query": [
						{ "key": "completed", "value": "false" },
						{ "key": "priority", "value": "ALTA" },
						{ "key": "sort", "value": "dueDate,asc" }
					]
				}
			}
		},
		{
			"name": "Obtener tarea por id",
			"request": {
				"method": "GET",
				"url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
			}
		},
		{
			"name": "Actualizar tarea",
			"request": {
				"method": "PUT",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Preparar entrevista técnica\",\n  \"description\": \"Repasar Spring Boot, JPA y SQL\",\n  \"completed\": true,\n  \"priority\": \"ALTA\",\n  \"dueDate\": \"2026-12-15\"\n}"
				},
				"url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
			}
		},
		{
			"name": "Eliminar tarea",
			"request": {
				"method": "DELETE",
				"url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
			}
		},
		{
			"name": "Error: crear sin título (400)",
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\n  \"title\": \"\"\n}" },
				"url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
			}
		}
	]
}
